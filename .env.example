# ============================================================================
# Agentic Graph-RAG — environment template
# Copy to .env and adjust values. All variables are prefixed with AGR_
# so they map 1:1 to Pydantic nested settings (AGR_<SECTION>__<KEY>).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Application
# ----------------------------------------------------------------------------
AGR_ENVIRONMENT=production          # development | staging | production
AGR_DEBUG=false                     # MUST be false in production
AGR_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
AGR_LOG_FORMAT=json                 # json | console

# ----------------------------------------------------------------------------
# 2. LLM (vLLM — OpenAI compatible)
# ----------------------------------------------------------------------------
LLM_MODEL=RedHatAI/Qwen3.5-9B-FP8-dynamic  # Updated model
LLM_API_KEY=EMPTY
VLLM_PORT=8000
VLLM_GPU_COUNT=1                           # Updated: 9B FP8 fits on a single 24GB GPU
VLLM_TP_SIZE=1                             # Updated: Must be 1 for single GPU
HF_TOKEN=                                  # Required to pull RedHatAI/Qwen3.5-9B-FP8-dynamic

# ----------------------------------------------------------------------------
# 3. Embeddings & Reranker
# ----------------------------------------------------------------------------
AGR_EMBEDDING__MODEL_NAME=BAAI/bge-large-en-v1.5
AGR_EMBEDDING__BATCH_SIZE=64
AGR_EMBEDDING__DIMENSIONS=1024      # MUST match AGR_QDRANT__VECTOR_SIZE
AGR_RERANKER__MODEL_NAME=BAAI/bge-reranker-v2-m3
AGR_RERANKER__TOP_K=5

# ----------------------------------------------------------------------------
# 4. Qdrant (vector store)
# ----------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
AGR_QDRANT__HOST=qdrant
AGR_QDRANT__PORT=6333
AGR_QDRANT__COLLECTION_CHUNKS=doc_chunks
AGR_QDRANT__COLLECTION_COMMUNITIES=community_summaries
AGR_QDRANT__VECTOR_SIZE=1024        # MUST match AGR_EMBEDDING__DIMENSIONS
AGR_QDRANT__DISTANCE=Cosine

# ----------------------------------------------------------------------------
# 5. Neo4j (graph store)
# ----------------------------------------------------------------------------
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme             # CHANGE ME in production
AGR_NEO4J__DATABASE=neo4j

# ----------------------------------------------------------------------------
# 6. Parsing & Chunking
# ----------------------------------------------------------------------------
AGR_PARSING__CHUNK_SIZE=1024
AGR_PARSING__CHUNK_OVERLAP=128
AGR_PARSING__PDF_PARSER=marker      # marker | pypdf | pdfplumber
AGR_PARSING__EXTRACT_TABLES=true

# ----------------------------------------------------------------------------
# 7. Agent (LangGraph)
# ----------------------------------------------------------------------------
AGR_AGENT__MAX_RETRIES=3
AGR_AGENT__ROUTER_CONFIDENCE_THRESHOLD=0.65
AGR_AGENT__GRAPH_RAG_ENABLED=true
AGR_AGENT__MAX_HOPS=4
AGR_AGENT__CITATION_REQUIRED=true
AGR_AGENT__SELF_CORRECTION_ENABLED=true

# ----------------------------------------------------------------------------
# 8. Ingestion (entity extraction)
# ----------------------------------------------------------------------------
AGR_INGESTION__CONFIDENCE_THRESHOLD=0.7
AGR_INGESTION__BATCH_SIZE=32

# ----------------------------------------------------------------------------
# 9. API & UI
# ----------------------------------------------------------------------------
API_PORT=8080
STREAMLIT_PORT=8501
AGR_API__WORKERS=2
AGR_API__RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# 10. LangSmith (optional tracing)
# ----------------------------------------------------------------------------
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-graph-rag