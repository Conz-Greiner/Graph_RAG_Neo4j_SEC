# LLM Ingestion (Throughput Optimized)
LLM_INGEST_BASE_URL=http://vllm-ingest:8000/v1
LLM_INGEST_MODEL=Qwen/Qwen3.5-9B-FP8-dynamic
LLM_INGEST_TIMEOUT=120.0
LLM_INGEST_MAX_CONCURRENCY=32
LLM_INGEST_MAX_MODEL_LEN=16384

# LLM Answering (Latency Optimized)
LLM_ANSWER_BASE_URL=http://vllm-answer:8001/v1
LLM_ANSWER_MODEL=Qwen/Qwen3.5-4B-FP8-dynamic
LLM_ANSWER_TIMEOUT=60.0
LLM_ANSWER_MAX_CONCURRENCY=64
LLM_ANSWER_STREAMING_ENABLED=true

# OCR (Unlimited-OCR)
OCR_ENABLED=false
OCR_BASE_URL=http://vllm-ocr:8000/v1
OCR_TIMEOUT=120.0
OCR_FALLBACK_THRESHOLD=0.8

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=true

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Agent
AGENT_MAX_ITERATIONS=10
AGENT_ROUTER_THRESHOLD=0.7

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graph-rag-sec
LANGSMITH_TRACING=true